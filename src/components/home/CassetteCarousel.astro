---
// Carrusel de casetes pixel: uno por artista, con su posición y nombre en la etiqueta.
interface Props {
  artists: string[];
  label: string;
}

const { artists, label } = Astro.props;
const spotify = (name: string) => `https://open.spotify.com/search/${encodeURIComponent(name)}/artists`;
---

<div class="deck" data-carousel>
  <div class="bar">
    <span>{label}</span>
    <div class="controls">
      <button type="button" class="ctrl" data-prev aria-label="Ver artistas anteriores">◀</button>
      <button type="button" class="ctrl" data-next aria-label="Ver más artistas">▶</button>
    </div>
  </div>

  <ol class="track" data-track aria-label={label}>
    {
      artists.map((name, i) => (
        <li class="item">
          <a
            href={spotify(name)}
            target="_blank"
            rel="noopener"
            class="tape"
            aria-label={`${name} en Spotify (se abre en otra pestaña)`}
          >
            <span class="label-strip">
              <span class="rank">LADO A · {String(i + 1).padStart(2, '0')}</span>
              <span class="name">{name}</span>
            </span>
            <span class="window" aria-hidden="true">
              <span class="reel" />
              <span class="tape-line" />
              <span class="reel" />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const step = () => Math.max(track.clientWidth * 0.8, 200);
    root.querySelector('[data-prev]')!.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]')!.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

<style>
  .deck {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 6px 6px 6px 12px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .controls {
    display: flex;
    gap: 6px;
  }
  .ctrl {
    width: 44px;
    height: 44px;
    border: none;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 14px;
    cursor: pointer;
  }
  .ctrl:hover {
    background: var(--surface);
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 8px 8px 16px;
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 8px;
    scrollbar-color: var(--ink) transparent;
  }
  .item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  /* casete */
  .tape {
    width: 200px;
    height: 132px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: var(--ink);
    background: var(--ink);
    box-shadow:
      -4px 0 0 0 var(--ink),
      4px 0 0 0 var(--ink),
      0 -4px 0 0 var(--ink),
      0 4px 0 0 var(--ink),
      8px 8px 0 0 var(--line);
  }
  .label-strip {
    flex: 1 1 auto;
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--surface);
    min-height: 0;
  }
  .rank {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .window {
    flex: 0 0 auto;
    height: 30px;
    padding: 0 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--line);
  }
  .reel {
    width: 20px;
    height: 20px;
    background: var(--surface);
    box-shadow: inset 0 0 0 6px var(--surface), inset 0 0 0 10px var(--ink);
  }
  .tape-line {
    flex: 1 1 auto;
    height: 4px;
    margin: 0 6px;
    background: var(--ink);
  }
  .tape:hover .reel,
  .tape:focus-visible .reel {
    animation: spin 0.8s steps(4) infinite;
  }
  .tape:hover .label-strip {
    background: var(--hatch);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
