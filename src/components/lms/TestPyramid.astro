---
import stats from '../../data/stats.json';

const modules = Object.entries(stats.tests).map(([id, m]) => ({ id, ...m }));
const initial = modules[0];
---

<div class="card pyramid" data-pyramid={JSON.stringify(stats.tests)}>
  <div class="selector" role="group" aria-label="Elegir módulo">
    {
      modules.map((m, i) => (
        <button type="button" data-mod={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {m.short}
        </button>
      ))
    }
  </div>

  <div class="body">
    <div class="tiers">
      <div class="tier e2e">
        <span class="mono n" data-field="e2e">{initial.e2e}</span>
        <span class="t">E2E</span>
      </div>
      <div class="tier integration">
        <span class="mono n" data-field="integration">{initial.integration}</span>
        <span class="t">Integración (Postgres real)</span>
      </div>
      <div class="tier unit">
        <span class="mono n" data-field="unit">{initial.unit}</span>
        <span class="t">Unitarios (backend + frontend)</span>
      </div>
    </div>

    <div class="info" aria-live="polite">
      <div class="kicker">Módulo</div>
      <div class="name" data-field="label">{initial.label}</div>
      <div class="total">
        <span class="mono" data-field="total">{initial.unit + initial.integration + initial.e2e}</span> tests en total
      </div>
      <div class="gap" data-gap hidden>Sin E2E todavía. Mostrar el hueco también es honesto.</div>
    </div>
  </div>
  <p class="source mono">Fuente: {stats.source} · {stats.generatedAt}</p>
</div>

<script>
  type Mod = { label: string; unit: number; integration: number; e2e: number };

  document.querySelectorAll<HTMLElement>('[data-pyramid]').forEach((root) => {
    const data: Record<string, Mod> = JSON.parse(root.dataset.pyramid ?? '{}');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mod]')];
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
    const gap = root.querySelector<HTMLElement>('[data-gap]')!;

    const select = (id: string) => {
      const m = data[id];
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mod === id)));
      field('unit').textContent = String(m.unit);
      field('integration').textContent = String(m.integration);
      field('e2e').textContent = String(m.e2e);
      field('label').textContent = m.label;
      field('total').textContent = String(m.unit + m.integration + m.e2e);
      gap.hidden = m.e2e !== 0;
    };

    buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.mod!)));
  });
</script>

<style>
  .pyramid {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .selector {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .selector button {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .selector button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .tiers {
    flex: 2 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  /* Cada nivel con un tono distinto de la paleta (en 8-bit acento y tinta coinciden). */
  .tier {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 12px 8px;
    box-shadow:
      -4px 0 0 0 var(--gb-0),
      4px 0 0 0 var(--gb-0),
      0 -4px 0 0 var(--gb-0),
      0 4px 0 0 var(--gb-0);
  }
  .tier .n {
    font-family: var(--font-display);
    line-height: 1;
  }
  .tier .t {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .e2e {
    width: 40%;
    min-height: 72px;
    background: var(--cart);
    color: #f4eef2;
  }
  .e2e .n {
    font-size: 20px;
  }
  .integration {
    width: 70%;
    min-height: 80px;
    background: var(--gb-1);
    color: var(--gb-3);
  }
  .integration .n {
    font-size: 22px;
  }
  .unit {
    width: 100%;
    min-height: 88px;
    background: var(--gb-3);
    color: var(--gb-0);
  }
  .unit .n {
    font-size: 26px;
  }
  .info {
    flex: 1 1 220px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .name {
    font-size: 28px;
    font-weight: 700;
  }
  .total {
    color: var(--ink-2);
  }
  .total .mono {
    font-weight: 600;
    color: var(--data);
  }
  .gap {
    border: 1.5px dashed var(--data);
    background: var(--data-soft);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
  }
  .gap[hidden] {
    display: none;
  }
  .source {
    font-size: 12px;
    color: var(--muted);
  }
</style>
